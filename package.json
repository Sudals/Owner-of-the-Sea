{
  "name": "owner-of-the-sea",
  "private": true,
  "description": "바다의 주인 — 2D 도트 낚시 게임 (web demo + Electron) monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sea/api --filter @sea/client dev",
    "dev:client": "pnpm --filter @sea/client dev",
    "dev:demo": "pnpm --filter @sea/client dev:demo",
    "dev:api": "pnpm --filter @sea/api dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "sprites": "pnpm --filter @sea/sprites sprites",
    "screenshot": "node scripts/screenshot.mjs",
    "db:generate": "pnpm --filter @sea/api db:generate",
    "db:migrate": "pnpm --filter @sea/api db:migrate",
    "deploy:api": "pnpm --filter @sea/api deploy",
    "desktop": "pnpm --filter @sea/client build && pnpm --filter @sea/desktop start",
    "dist:win": "pnpm --filter @sea/desktop dist:win"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
