# 바다의 주인 API (apps/api) — environment
# `neon deploy` / `neon env pull` writes the Neon values into .env.local automatically.
# On Neon Functions these are injected at runtime; locally `neon dev --env .env.local` injects them.

# --- from Neon (do not hand-edit) ---
DATABASE_URL=            # pooled: app queries
DATABASE_URL_UNPOOLED=   # direct: drizzle-kit migrations
NEON_BRANCH=
NEON_FUNCTION_API_BASE_URL=
AWS_ACCESS_KEY_ID=       # Neon Object Storage (S3-compatible)
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# --- app secrets (NOT from Neon) — declared in neon.ts functions.api.env ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# `neon deploy --env .env.local` uploads them to the function. Never leave them empty.
SESSION_PEPPER=          # keys the session-token hash (HMAC-SHA256)
SEED_HMAC_KEY=           # signs fishing-session seeds (design §11-3)
