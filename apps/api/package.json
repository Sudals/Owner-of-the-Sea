{
  "name": "@sea/api",
  "version": "0.1.0",
  "private": true,
  "description": "바다의 주인 API — Hono on Neon Functions (Node.js 24)",
  "type": "module",
  "scripts": {
    "dev": "neon dev --env .env.local",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "deploy": "neon deploy --env .env.local",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@neon/functions": "^0.11.0",
    "@sea/shared": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6"
  }
}
