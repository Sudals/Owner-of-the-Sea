{
  "name": "@sea/client",
  "version": "0.1.0",
  "private": true,
  "description": "바다의 주인 client — Vite + React UI over the canvas game (web demo & desktop)",
  "type": "module",
  "scripts": {
    "dev": "vite --mode full",
    "dev:demo": "vite --mode demo",
    "build": "vite build --mode demo && vite build --mode full",
    "preview": "vite preview --mode full",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sea/game": "workspace:^",
    "@sea/shared": "workspace:^",
    "galmuri": "^2.40.3",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^6",
    "vite": "^8"
  }
}
