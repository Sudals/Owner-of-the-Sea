// ═══════════════════════════════════════════════════════════════════════════════════════
//  바다의 주인 — 밸런스 설정 (확률 · 능력치 · 경제 · 점수)
// ═══════════════════════════════════════════════════════════════════════════════════════
//  게임 안의 모든 수치는 이 파일 한 곳에서 고친다. 설계 근거: design.md §3-3·§4, Economy.md (v3).
//
//  고친 뒤 적용:   pnpm balance:apply "무엇을 바꿨는지 한 줄"
//    1) 이 파일을 검사한다 (빠진 값, 오타, 범위)
//    2) DB game_config 테이블에 새 버전으로 저장한다 → 서버가 30초 안에 새 값을 쓴다
//    3) 게임에 같이 들어가는 기본값(packages/shared/src/balance/balance.default.json)도 갱신한다
//       → 체험판·오프라인은 다음 빌드부터 새 값
//  검사만:          pnpm balance:check
//
//  규칙
//  · 확률표의 숫자는 "가중치"다. 합이 100일 필요는 없고, 서로의 비율만 의미가 있다.
//  · 배율(×)은 1이 기본. 0.8 = 20% 싸게/낮게, 1.5 = 50% 비싸게/높게.
//  · 낚시 세션은 열릴 때의 설정 버전을 기억한다. 수치를 바꿔도 이미 던진 캐스트는 옛 값으로 검증된다.
//  · 아이디(anchovy, water_market, bait_worm …)는 코드와 그림이 쓰는 이름이라 바꾸면 안 된다.
// ═══════════════════════════════════════════════════════════════════════════════════════
{
  // ─────────────────────────────────────────────────────────────────────────────────────
  //  1. 물고기 능력치
  // ─────────────────────────────────────────────────────────────────────────────────────
  //  grade    등급: common 일반 · uncommon 고급 · rare 희귀 · legendary 전설 · boss 오염체
  //  sizeCm   [최소, 최대] 몸길이. 크기 등급(D~S)은 이 범위 안에서 정해진다 (fishing.sizeBands)
  //  power    1~10   릴 미니게임에서 당기는 힘
  //  erratic  0~1    몸부림(갑자기 세게 당김)이 잦은 정도
  //  price    0.8~1.2  같은 등급·바다 기본가에 곱하는 어종별 보정 (Economy.md §2-2)
  //  deep     true면 심해어 카테고리 (섬마다 매입 배율이 따로 있음)
  //  tier     오염체 등급 C/B/A/S (오염체만)
  "fish": {
    "anchovy":          { "name": "멸치",       "grade": "common",    "sizeCm": [6, 15],    "power": 1,   "erratic": 0.2,  "price": 1.01 },
    "sardine":          { "name": "정어리",     "grade": "common",    "sizeCm": [12, 25],   "power": 1.5, "erratic": 0.2,  "price": 0.99 },
    "gizzard_shad":     { "name": "전어",       "grade": "common",    "sizeCm": [15, 30],   "power": 2,   "erratic": 0.3,  "price": 1.04 },
    "herring":          { "name": "청어",       "grade": "common",    "sizeCm": [20, 40],   "power": 2,   "erratic": 0.2,  "price": 1.08 },
    "goby":             { "name": "망둥어",     "grade": "common",    "sizeCm": [8, 20],    "power": 1,   "erratic": 0.4,  "price": 0.81 },
    "red_seabream":     { "name": "참돔",       "grade": "rare",      "sizeCm": [30, 90],   "power": 6,   "erratic": 0.4,  "price": 1.05 },
    "black_seabream":   { "name": "감성돔",     "grade": "uncommon",  "sizeCm": [25, 55],   "power": 5,   "erratic": 0.5,  "price": 0.95 },
    "striped_beakfish": { "name": "돌돔",       "grade": "rare",      "sizeCm": [25, 60],   "power": 7,   "erratic": 0.5,  "price": 1.14 },
    "filefish":         { "name": "쥐치",       "grade": "common",    "sizeCm": [15, 35],   "power": 3,   "erratic": 0.5,  "price": 1.00 },
    "opaleye":          { "name": "벵에돔",     "grade": "uncommon",  "sizeCm": [25, 50],   "power": 5,   "erratic": 0.6,  "price": 1.10 },
    "koi":              { "name": "비단잉어",   "grade": "rare",      "sizeCm": [40, 90],   "power": 4,   "erratic": 0.3,  "price": 0.84 },
    "golden_seabream":  { "name": "황금 참돔",  "grade": "legendary", "sizeCm": [60, 110],  "power": 9.5, "erratic": 0.7,  "price": 0.88 },
    "saury":            { "name": "꽁치",       "grade": "common",    "sizeCm": [25, 40],   "power": 2,   "erratic": 0.3,  "price": 1.14 },
    "halfbeak":         { "name": "학공치",     "grade": "common",    "sizeCm": [25, 40],   "power": 2,   "erratic": 0.5,  "price": 0.80 },
    "needlefish":       { "name": "동갈치",     "grade": "uncommon",  "sizeCm": [50, 100],  "power": 4,   "erratic": 0.7,  "price": 1.11 },
    "mackerel":         { "name": "고등어",     "grade": "common",    "sizeCm": [25, 45],   "power": 3,   "erratic": 0.5,  "price": 0.80 },
    "horse_mackerel":   { "name": "전갱이",     "grade": "common",    "sizeCm": [20, 40],   "power": 3,   "erratic": 0.4,  "price": 0.87 },
    "mullet":           { "name": "숭어",       "grade": "common",    "sizeCm": [30, 70],   "power": 4,   "erratic": 0.4,  "price": 1.19 },
    "sea_bass":         { "name": "농어",       "grade": "uncommon",  "sizeCm": [40, 100],  "power": 6,   "erratic": 0.5,  "price": 1.13 },
    "salmon":           { "name": "연어",       "grade": "rare",      "sizeCm": [50, 90],   "power": 7,   "erratic": 0.4,  "price": 0.97 },
    "spanish_mackerel": { "name": "삼치",       "grade": "uncommon",  "sizeCm": [50, 100],  "power": 6,   "erratic": 0.4,  "price": 1.03 },
    "yellowtail":       { "name": "방어",       "grade": "uncommon",  "sizeCm": [50, 110],  "power": 7,   "erratic": 0.4,  "price": 1.20 },
    "skipjack":         { "name": "가다랑어",   "grade": "uncommon",  "sizeCm": [40, 80],   "power": 6,   "erratic": 0.3,  "price": 1.19 },
    "bluefin_tuna":     { "name": "참다랑어",   "grade": "rare",      "sizeCm": [100, 250], "power": 10,  "erratic": 0.3,  "price": 0.97 },
    "conger":           { "name": "붕장어",     "grade": "common",    "sizeCm": [40, 100],  "power": 4,   "erratic": 0.6,  "price": 0.99 },
    "moray":            { "name": "곰치",       "grade": "uncommon",  "sizeCm": [60, 150],  "power": 6,   "erratic": 0.7,  "price": 1.13 },
    "pike_conger":      { "name": "갯장어",     "grade": "uncommon",  "sizeCm": [60, 150],  "power": 5,   "erratic": 0.6,  "price": 0.95 },
    "cutlassfish":      { "name": "갈치",       "grade": "common",    "sizeCm": [60, 150],  "power": 4,   "erratic": 0.4,  "price": 0.83 },
    "ghost_cutlass":    { "name": "유령 갈치",  "grade": "legendary", "sizeCm": [120, 200], "power": 9,   "erratic": 0.85, "price": 1.17, "deep": true },
    "pufferfish":       { "name": "복어",       "grade": "common",    "sizeCm": [15, 35],   "power": 2,   "erratic": 0.6,  "price": 1.08 },
    "grass_puffer":     { "name": "졸복",       "grade": "common",    "sizeCm": [10, 20],   "power": 1,   "erratic": 0.6,  "price": 1.05 },
    "porcupinefish":    { "name": "가시복",     "grade": "uncommon",  "sizeCm": [20, 45],   "power": 3,   "erratic": 0.6,  "price": 1.20 },
    "sunfish":          { "name": "개복치",     "grade": "rare",      "sizeCm": [100, 300], "power": 9,   "erratic": 0.1,  "price": 1.15 },
    "rockfish":         { "name": "우럭",       "grade": "common",    "sizeCm": [20, 50],   "power": 4,   "erratic": 0.3,  "price": 1.16 },
    "scorpionfish":     { "name": "쏨뱅이",     "grade": "common",    "sizeCm": [15, 30],   "power": 3,   "erratic": 0.4,  "price": 1.11 },
    "greenling":        { "name": "쥐노래미",   "grade": "common",    "sizeCm": [20, 50],   "power": 4,   "erratic": 0.4,  "price": 0.89 },
    "dark_rockfish":    { "name": "볼락",       "grade": "common",    "sizeCm": [15, 30],   "power": 3,   "erratic": 0.3,  "price": 0.87 },
    "catfish":          { "name": "메기",       "grade": "uncommon",  "sizeCm": [40, 100],  "power": 5,   "erratic": 0.3,  "price": 1.12 },
    "anglerfish":       { "name": "아귀",       "grade": "uncommon",  "sizeCm": [40, 100],  "power": 5,   "erratic": 0.2,  "price": 1.19, "deep": true },
    "lantern_angler":   { "name": "초롱아귀",   "grade": "rare",      "sizeCm": [20, 40],   "power": 4,   "erratic": 0.5,  "price": 0.88, "deep": true },
    // 오염체 (design §4-5) — 바다 색이 아니라 등급(tier)으로 값이 정해진다 (economy.bossBasePrice)
    "plastic_mullet":    { "name": "비닐감긴 숭어",       "grade": "boss", "tier": "C", "sizeCm": [60, 90],    "power": 6,  "erratic": 0.7, "price": 1 },
    "oil_mackerel_king": { "name": "기름먹은 고등어떼왕", "grade": "boss", "tier": "B", "sizeCm": [60, 100],   "power": 7,  "erratic": 0.8, "price": 1 },
    "net_shark":         { "name": "그물을 끄는 상어",    "grade": "boss", "tier": "A", "sizeCm": [200, 400],  "power": 9,  "erratic": 0.8, "price": 1 },
    "drum_whale":        { "name": "드럼통 고래",         "grade": "boss", "tier": "S", "sizeCm": [800, 1200], "power": 10, "erratic": 0.6, "price": 1 }
  },

  // ─────────────────────────────────────────────────────────────────────────────────────
  //  2. 낚시 확률 (design §4-8)
  // ─────────────────────────────────────────────────────────────────────────────────────
  "fishing": {
    // 캐스팅 후 입질까지 기다리는 시간 [최소, 최대] 초
    "waitSec": [2, 8],
    // 입질("!")이 뜬 뒤 버튼을 눌러야 하는 시간 (초)
    "biteWindowSec": 0.6,

    // 바다 색별 기본 확률표. grade = 물고기 등급 가중치, size = 크기 등급 가중치
    "zoneOdds": {
      "jade":   { "grade": { "common": 78, "uncommon": 17, "rare": 4.6, "legendary": 0.4 }, "size": { "D": 40, "C": 30, "B": 18, "A": 9,  "S": 3 } },
      "azure":  { "grade": { "common": 62, "uncommon": 27, "rare": 10,  "legendary": 1 },   "size": { "D": 34, "C": 30, "B": 20, "A": 12, "S": 4 } },
      "indigo": { "grade": { "common": 48, "uncommon": 33, "rare": 16,  "legendary": 3 },   "size": { "D": 28, "C": 28, "B": 22, "A": 16, "S": 6 } },
      "ink":    { "grade": { "common": 38, "uncommon": 36, "rare": 21,  "legendary": 5 },   "size": { "D": 22, "C": 26, "B": 24, "A": 20, "S": 8 } }
    },

    // 크기 등급이 어종 몸길이 범위의 어디쯤인지 [시작, 끝] (0 = 최소, 1 = 최대)
    "sizeBands": { "D": [0, 0.35], "C": [0.35, 0.6], "B": [0.6, 0.8], "A": [0.8, 0.93], "S": [0.93, 1] },

    // 확률 보정 (해당 등급의 가중치에 곱함)
    "dockOdds":      { "grade": { "rare": 0.8, "legendary": 0.5 }, "size": { "A": 0.8, "S": 0.6 } },   // 선착장(얕은 물): 희귀·대형이 덜 나옴
    "deepTileBonus": { "grade": { "rare": 1.5, "legendary": 2 },   "size": { "A": 1.5, "S": 2 } },     // 탑다운 맵의 어두운 심해 칸
    "stormBonus":    { "grade": { "rare": 1.4, "legendary": 1.6 } },                                    // 폭풍 속에서 낚시

    // 포인트별로 사는 어종. 등급에 맞는 어종이 없으면 한 등급 아래에서 뽑는다
    "pools": {
      "sea": {
        "jade":   ["anchovy", "sardine", "halfbeak", "mackerel", "horse_mackerel", "mullet", "pufferfish", "herring", "black_seabream", "needlefish", "sea_bass", "koi", "red_seabream", "golden_seabream"],
        "azure":  ["mackerel", "saury", "filefish", "conger", "horse_mackerel", "sea_bass", "spanish_mackerel", "yellowtail", "opaleye", "red_seabream", "striped_beakfish", "salmon", "golden_seabream"],
        "indigo": ["cutlassfish", "greenling", "scorpionfish", "skipjack", "yellowtail", "moray", "opaleye", "salmon", "bluefin_tuna", "sunfish", "ghost_cutlass"],
        "ink":    ["dark_rockfish", "scorpionfish", "cutlassfish", "anglerfish", "pike_conger", "moray", "lantern_angler", "sunfish", "ghost_cutlass"]
      },
      "dock": {
        "jade":   ["anchovy", "sardine", "gizzard_shad", "goby", "filefish", "halfbeak", "rockfish", "pufferfish", "grass_puffer", "black_seabream", "porcupinefish", "red_seabream", "koi", "golden_seabream"],
        "azure":  ["mackerel", "saury", "filefish", "conger", "horse_mackerel", "greenling", "sea_bass", "opaleye", "red_seabream", "striped_beakfish", "golden_seabream"],
        "indigo": ["cutlassfish", "greenling", "scorpionfish", "rockfish", "moray", "catfish", "opaleye", "salmon", "sunfish", "ghost_cutlass"],
        "ink":    ["dark_rockfish", "scorpionfish", "pike_conger", "anglerfish", "catfish", "lantern_angler", "ghost_cutlass"]
      }
    },
    // 바다 색별로 나타나는 오염체 (진실 이후)
    "pollutantBySea": { "jade": "plastic_mullet", "azure": "oil_mackerel_king", "indigo": "net_shark", "ink": "drum_whale" },

    // 미끼 효과 (Economy.md §4-1). 입질이 왔을 때 1개 쓴다 (놓쳐도 쓰고, 입질 전에 거두면 안 쓴다).
    //  grade/size  해당 가중치에 곱함 (곱한 뒤 비율로 다시 맞춘다)
    //  waitMul     입질 대기 시간 배율 (0.6 = 40% 빨리 문다)
    //  onlyDeep    남빛·먹빛 바다나 심해 칸에서만 효과
    //  rot         이 미끼로 잡은 물고기의 신선도 감소 속도 배율
    //  largeFish   대형 어종을 고를 가중치 (지금은 쓰지 않음)
    "bait": {
      "bait_worm":   {},
      "bait_shrimp": { "waitMul": 0.6 },
      "bait_lure":   { "grade": { "uncommon": 1.5, "rare": 2 } },
      "bait_big":    { "size": { "A": 1.5, "S": 2 } },
      "bait_glow":   { "grade": { "rare": 1.5, "legendary": 3 }, "onlyDeep": true },
      "bait_black":  { "grade": { "uncommon": 1.3, "rare": 2, "legendary": 2 }, "size": { "A": 1.5, "S": 2 }, "rot": 1.5 },
      // 미끼가 없을 때(맨 바늘): 효과 없음, 입질이 늦다
      "none":        { "waitMul": 1.5 }
    },

    // 쓰레기 (design §1 "낚싯줄에는 옛 세계의 쓰레기가 걸려 올라온다", §6-2).
    // 캐스트마다 물고기 대신 쓰레기가 걸릴 수 있다. 미끼와 상관없이 걸리고(입질로 치니 미끼는 쓴다),
    // 창고 한 칸을 차지한다. 섬에서 개당 고정가(markets.*.trashFlat)로 처리하고, 처리하면 2점(진실 이후).
    //  chance     바다별로 쓰레기가 걸릴 확률 (0.1 = 10%)
    //  dockBonus  선착장(사람 사는 섬 바로 앞)에서 더하는 확률
    //  kinds      종류. weight = 걸린 쓰레기 중 이 종류의 비율, bySea = 그 바다에서 weight에 곱하는 값,
    //             sizeCm = 크기(표시용), power/erratic = 릴 미니게임에서 얼마나 무겁고 흔들리는지
    "trash": {
      "chance": { "jade": 0.10, "azure": 0.08, "indigo": 0.07, "ink": 0.14 },
      "dockBonus": 0.06,
      "kinds": {
        "trash_bag":    { "name": "비닐봉지",     "weight": 30, "sizeCm": [20, 45], "power": 0.6, "erratic": 0.15 },
        "trash_bottle": { "name": "페트병",       "weight": 28, "sizeCm": [15, 30], "power": 0.5, "erratic": 0.05 },
        "trash_can":    { "name": "찌그러진 깡통", "weight": 16, "sizeCm": [8, 14],  "power": 0.4, "erratic": 0 },
        "trash_boot":   { "name": "낡은 장화",     "weight": 12, "sizeCm": [25, 35], "power": 1.0, "erratic": 0.1 },
        "trash_net":    { "name": "그물 뭉치",     "weight": 8,  "sizeCm": [40, 90], "power": 1.8, "erratic": 0.2, "bySea": { "azure": 1.5, "indigo": 2 } },
        "trash_tire":   { "name": "폐타이어",     "weight": 5,  "sizeCm": [50, 70], "power": 2.4, "erratic": 0 },
        // 기름 드럼은 깊고 더러운 바다일수록 (먹빛 '버려진 골' = 옛 폐기물 투기 해역)
        "trash_drum":   { "name": "기름 드럼",     "weight": 2,  "sizeCm": [60, 90], "power": 3.0, "erratic": 0, "bySea": { "indigo": 3, "ink": 8 } }
      }
    }
  },

  // ─────────────────────────────────────────────────────────────────────────────────────
  //  3. 릴 미니게임 (design §4-2)
  // ─────────────────────────────────────────────────────────────────────────────────────
  "reel": {
    "slackLimit": 1.5,     // 텐션이 0인 채로 이만큼(초) 지나면 물고기가 빠진다
    "holdRise": 0.25,      // 감는 동안 기본 텐션 상승(/초)
    "pullRise": 0.5,       // 물고기가 당기는 힘 1당 추가 텐션 상승(/초)
    "releaseFall": 0.9,    // 놓았을 때 텐션 하강(/초)
    "minFall": 0.3,        // 아무리 센 물고기라도 놓으면 최소 이만큼은 내려간다
    "bossMult": 2.0,       // 오염체는 힘 ×2
    "baseSpeed": 3.2,      // 낚싯대 Lv1의 감기 속도 (m/초)
    // 낚싯대 레벨별 감기 속도 배율 [Lv1, Lv2, Lv3, Lv4, Lv5]  (Economy.md §4-2)
    "rodSpeed": [1, 1.15, 1.3, 1.45, 1.6],
    // 낚싯줄 레벨별 텐션 최대치 배율 [Lv1 = 100, Lv2 = 120, …]
    "lineMax": [1, 1.2, 1.4, 1.65, 1.9]
  },

  // ─────────────────────────────────────────────────────────────────────────────────────
  //  4. 배 · 항해 (design §3-3, §3-4)
  // ─────────────────────────────────────────────────────────────────────────────────────
  "boat": {
    // 선체 레벨별: 내구도, 최고 속도(px/초, 16px = 1칸), 충돌 반지름(px)
    "hulls": {
      "1": { "name": "통통배",    "hp": 100, "speed": 66,  "radius": 5 },
      "2": { "name": "흰 통통배", "hp": 150, "speed": 78,  "radius": 5 },
      "3": { "name": "철선",      "hp": 220, "speed": 90,  "radius": 6 },
      "4": { "name": "큰 철선",   "hp": 300, "speed": 104, "radius": 7 }
    },
    // 연료통 레벨별 최대 연료
    "tankCap": { "1": 100, "2": 200, "3": 350 },
    "fuelPerTile": 0.45,   // 한 칸(16px) 갈 때 쓰는 연료
    "rowFactor": 0.3,      // 연료가 떨어지면 노를 젓는다: 최고 속도의 이 비율
    // 충돌 피해 (Economy.md §4-6): 최고 속도로 부딪히면 최대 내구도의 reefPctAtTop(암초) / shorePctAtTop(해안·잔교),
    // 느리면 비례해서 줄어든다. minSpeed 이하로 닿으면 피해 없음
    "impact": { "minSpeed": 18, "reefPctAtTop": 0.10, "shorePctAtTop": 0.05 },
    // 폭풍 속: 1분에 최대 내구도의 이 비율 (폭풍 세기에 비례)
    "stormDamagePctPerMin": 0.03,
    // 신선도: 1분에 몇 % 떨어지나 [얼음 창고 없음, Lv1, Lv2, Lv3]  (Economy.md §2-5)
    "freshDecayPerMin": [1, 0.7, 0.5, 0.35],
    // 화물칸 레벨별 창고 칸 수
    "holdCap": { "1": 20, "2": 30, "3": 45, "4": 60 },
    // 선체가 0이 되어 견인될 때 잃는 물고기 비율
    "towLossRate": 0.3
  },

  // ─────────────────────────────────────────────────────────────────────────────────────
  //  5. 경제 (Economy.md)
  // ─────────────────────────────────────────────────────────────────────────────────────
  "economy": {
    // 새 게임 시작 자금과 지렁이 (Economy.md §6-2)
    "start": { "gold": 50, "worms": 20 },

    // 어종 기본가: 등급 × 잡은 바다 색 (§2-2). 어종별 보정은 fish.*.price
    "basePrice": {
      "common":    { "jade": 8,   "azure": 13,  "indigo": 21,  "ink": 32 },
      "uncommon":  { "jade": 25,  "azure": 40,  "indigo": 65,  "ink": 100 },
      "rare":      { "jade": 80,  "azure": 128, "indigo": 208, "ink": 320 },
      "legendary": { "jade": 300, "azure": 480, "indigo": 780, "ink": 1200 }
    },
    // 오염체 기본가 (등급별)
    "bossBasePrice": { "C": 150, "B": 400, "A": 1000, "S": 2500, "SS": 5000 },
    // 크기 등급 배율 (§2-3). 점수(D×0.5~S×2)보다 폭이 좁다: 골드는 꾸준히, 점수는 한 방
    "sizeMult": { "D": 0.7, "C": 0.9, "B": 1.0, "A": 1.3, "S": 1.8 },
    // 몸길이 기준값(범위의 가운데)이 이 이상이면 "대형", 아니면 "소형" (§2-4)
    "largeFromCm": 40,
    // 신선도 구간별 판매 배율 (§2-5): 이 % 이상이면 이 배율
    "freshBands": [
      { "from": 80, "name": "싱싱함", "mult": 1.0 },
      { "from": 50, "name": "보통",   "mult": 0.85 },
      { "from": 20, "name": "시듦",   "mult": 0.6 },
      { "from": 0,  "name": "상함",   "mult": 0.2 }
    ],
    // 소금 절임한 물고기의 판매 배율 (소금꽃섬은 제값: markets.salt_flower.saltedFullPrice)
    "saltedMult": 0.9,
    // 수요 배율 (§2-6): 섬마다·어종마다 최근 판매량을 센다.
    //  freeCount 마리까지는 제값, 그다음 1마리마다 stepPerFish씩 내려가 floor에서 멈춘다.
    //  최근 판매량은 recoverMinPerFish분에 1마리씩 회복된다 (날짜 초기화 없음)
    //  화면 표시: 최근 판매량 < steady → 충분 · < short → 보통 · 그 이상 → 부족
    "demand": { "freeCount": 20, "stepPerFish": 0.015, "floor": 0.7, "recoverMinPerFish": 3, "steady": 20, "short": 30 },
    // 연료 1단위 기준가 (섬 연료 배율을 곱함)
    "fuelUnitPrice": 1,
    // 수리: 선체 레벨별 내구도 1당 기준가 (섬 수리 배율을 곱함, §4-6)
    "repairPerHp": { "1": 0.5, "2": 1.0, "3": 1.5, "4": 2.0 },
    // 수리 키트: 선체 레벨별 가격 (= 25% 수리비 × 1.5, 항구 수리보다 항상 비쌈)
    "repairKitPrice": { "1": 20, "2": 55, "3": 125, "4": 225 },
    // 견인비 = 그 섬의 전부 수리비 × towFeeRate (수리비는 따로 낸다). 골드가 모자라면 0까지만
    "towFeeRate": 0.5,
    // 소모품을 썼을 때 (Economy.md §4-5, §4-6). 어디서나 쓸 수 있다 (창고·장비 화면, 바다에서 R = 수리 키트)
    //  repairKitPct  수리 키트 1개가 채우는 내구도 (최대 내구도 대비, 0.25 = 25%)
    //  iceChunkPct   얼음 덩이 1개가 창고 전체 물고기의 신선도를 올리는 양 (%p, 100은 넘지 않음)
    //  소금은 물고기 1마리의 신선도를 지금 값으로 고정하고 판매가 × saltedMult (소금꽃섬은 제값)
    "consumables": { "repairKitPct": 0.25, "iceChunkPct": 10 },

    // 지금 문을 연 마을 (나머지는 섬 이야기와 함께 M7에서 연다)
    "openIslands": ["red_lighthouse", "water_market", "salt_flower", "bell_tower"],

    // 섬별 시세와 상점 (§3-1, §5) — 물장터는 '편한 정답'(기본 배율 최고, 변동 작음),
    // 다른 섬은 '귀찮음을 감수하면 더 버는 곳'(변동 크고 특가 많음)
    //  buy          카테고리별 매입 배율. 빠진 카테고리는 그 섬에서 사지 않는다
    //               small 소형 · large 대형 · deep 심해어 · relic 유물 · polluted 오염체
    //  trashFlat    쓰레기 개당 고정 매입가
    //  volatility   일일 변동 폭 (0.2 = ±20%). KST 자정에 바뀐다
    //  specials / specialMult  오늘의 특가 어종 수와 배율 (특가 수 ≈ 그 바다 어종 수의 1/4)
    //  collector    희귀·전설 추가 배율 (유리탑섬 수집가)
    //  saltedFullPrice  소금 절임 생선을 −10% 없이 제값에 산다
    //  items        물건 가격 배율 · itemOverride 품목별 예외 배율
    //  fuel / repair  연료·수리 서비스 배율 (null = 서비스 없음)
    //  dailyWorms   하루 무료 지렁이 · appraise 유물 감정비 · toll 접안 통행료
    "markets": {
      "red_lighthouse": {
        "buy": { "small": 0.8, "large": 0.8 }, "trashFlat": 2, "volatility": 0, "specials": 0, "specialMult": 1, "items": 1, "shop": [],
        "fuel": null, "repair": 0.5, "dailyWorms": 20,
        "keeper": "덕배 할멈", "line": "네 할아비 배는 동네 사람들이랑 반값에 고쳐 주마. 물고기도 좀 사 주지."
      },
      "water_market": {
        "buy": { "small": 1.15, "large": 1.1, "deep": 1.05, "relic": 0.8, "polluted": 1.0 }, "trashFlat": 2, "volatility": 0.08, "specials": 1, "specialMult": 1.5, "items": 1,
        "shop": ["bait_worm", "bait_shrimp", "rod_2", "line_2", "hold_2"], "fuel": 1.0, "repair": 1.0,
        "keeper": "말순", "line": "바다? 값을 치르는 사람 거지. 우리 장터는 어느 날 와도 손해 안 봐."
      },
      "salt_flower": {
        "buy": { "small": 0.9, "large": 0.9, "deep": 0.9 }, "trashFlat": 3, "volatility": 0.2, "specials": 3, "specialMult": 2, "saltedFullPrice": true,
        "items": 1, "itemOverride": { "bait_worm": 0.6, "bait_shrimp": 0.6, "salt": 0.6, "ice_chunk": 0.6 },
        "shop": ["bait_worm", "bait_shrimp", "salt", "ice_chunk", "ice_1", "ice_2"], "fuel": 1.0, "repair": 1.1,
        "keeper": "강노인", "line": "바다는 땀 흘려 일하는 사람 거야. 소금에 절인 건 제값 쳐 주지."
      },
      "bell_tower": {
        "buy": { "small": 0.95, "large": 0.85, "relic": 0.7 }, "trashFlat": 3, "volatility": 0.2, "specials": 3, "specialMult": 2, "items": 0.9,
        "shop": ["rod_2", "line_2", "hull_2", "bait_worm"], "fuel": null, "repair": 1.0,
        "keeper": "아이 바다", "line": "바다는 다 같이 쓰는 거 아냐? 근데 왜 다들 자기 거래?"
      },
      "bridge": {
        "buy": { "small": 1.0, "large": 1.0, "deep": 1.0, "relic": 0.9, "polluted": 1.0 }, "trashFlat": 2, "volatility": 0.15, "specials": 3, "specialMult": 2, "items": 1,
        "shop": ["rod_3", "line_3", "bait_lure", "bait_shrimp", "repair_kit"], "fuel": 1.1, "repair": 1.0, "toll": 20,
        "keeper": "문씨", "line": "바다는 길을 가진 사람 것이지. 통행료는 스무 냥."
      },
      "junk": {
        "buy": { "small": 0.9, "large": 0.9, "deep": 0.9, "relic": 1.3, "polluted": 1.0 }, "trashFlat": 5, "volatility": 0.1, "specials": 1, "specialMult": 2, "items": 0.9,
        "shop": ["repair_kit", "hold_3", "bait_lure"], "fuel": null, "repair": 0.9, "appraise": 20,
        "keeper": "탁사장", "line": "건져 올린 사람 거지, 먼저 줍는 놈이 임자."
      },
      "rusty_port": {
        "buy": { "small": 0.95, "large": 1.15, "deep": 1.0, "relic": 1.0, "polluted": 1.0 }, "trashFlat": 3, "volatility": 0.15, "specials": 3, "specialMult": 2, "items": 1,
        "shop": ["hull_3", "tank_2", "tank_3", "repair_kit"], "fuel": 0.7, "repair": 0.6,
        "keeper": "최반장", "line": "태평호 선원들은 돈을 잘 벌었지. 뭘 싣고 나가는지는 아무도 안 물었고."
      },
      "whalebone": {
        "buy": { "small": 0.85, "large": 1.3, "deep": 1.1, "relic": 0.9, "polluted": 1.0 }, "trashFlat": 3, "volatility": 0.15, "specials": 3, "specialMult": 2, "items": 1.1,
        "shop": ["bait_big", "bait_glow", "bait_lure", "line_4", "ice_3"], "fuel": 1.0, "repair": 1.0,
        "keeper": "고래뼈 사람들", "line": "바다는 이미 죽은 것들의 것이야. 우린 그 위에 얹혀사는 거고."
      },
      "glass_tower": {
        "buy": { "small": 0.95, "large": 1.0, "deep": 1.2, "relic": 1.4, "polluted": 1.1 }, "volatility": 0.1, "specials": 1, "specialMult": 2, "collector": 1.2, "items": 1.5,
        "shop": ["hull_4", "rod_4", "rod_5", "line_4", "line_5", "tank_3", "hold_4", "bait_glow"], "fuel": 1.5, "repair": 1.5, "appraise": 40,
        "keeper": "태평해운 사람들", "line": "바다는 개발하는 자의 것."
      },
      "water_sound": {
        "buy": {}, "volatility": 0, "specials": 0, "specialMult": 1, "items": 1, "shop": [], "fuel": null, "repair": null,
        "keeper": "해월", "line": "바다는 바다 것이다. 사람은 잠시 빌려 쓸 뿐이지."
      },
      "black_sand": {
        "buy": { "small": 0.7, "large": 0.7, "deep": 0.8, "relic": 1.1, "polluted": 1.4 }, "trashFlat": 4, "volatility": 0.2, "specials": 1, "specialMult": 2,
        "items": 1, "itemOverride": { "bait_glow": 1.2 },
        "shop": ["bait_black", "bait_glow", "repair_kit"], "fuel": 1.3, "repair": 1.2,
        "keeper": "구렁이", "line": "바다는 살아남는 놈 거야."
      },
      "black_lighthouse": {
        "buy": { "small": 1.0, "large": 1.0, "deep": 1.05, "relic": 1.0, "polluted": 1.0 }, "trashFlat": 2, "volatility": 0, "specials": 0, "specialMult": 1, "items": 1,
        "shop": ["bait_worm", "bait_shrimp", "bait_glow", "salt", "ice_chunk", "repair_kit"], "fuel": 1.0, "repair": 1.0,
        "keeper": "윤씨", "line": "바다는… 글쎄다. 난 그 질문에 답할 자격이 없는 사람이야."
      }
    },

    // 아이템 기준가 (§4). 실제 가격 = 기준가 × 묶음 수 × 그 섬의 물건 배율 (소수점 올림, 최소 1G)
    //  kind   bait 미끼 · rod 낚싯대 · line 낚싯줄 · hull 선체 · tank 연료통 · ice 얼음 창고 · hold 화물칸 · consumable 소모품
    //  level  장비 레벨 (한 단계씩 순서대로만 산다) · bundle 묶음 개수(미끼) · max 최대 소지 수
    "items": {
      "bait_worm":   { "kind": "bait", "name": "지렁이",      "desc": "기본 미끼",                               "price": 1,  "bundle": 20 },
      "bait_shrimp": { "kind": "bait", "name": "새우 미끼",   "desc": "입질이 40% 빨리 온다",                    "price": 2,  "bundle": 20 },
      "bait_lure":   { "kind": "bait", "name": "반짝이 루어", "desc": "고급 ×1.5 · 희귀 ×2",                     "price": 4,  "bundle": 20 },
      "bait_big":    { "kind": "bait", "name": "대형 미끼",   "desc": "크기 A급 ×1.5 · S급 ×2",                  "price": 4,  "bundle": 20 },
      "bait_glow":   { "kind": "bait", "name": "발광 미끼",   "desc": "희귀 ×1.5 · 전설 ×3 (남빛·먹빛·심해 칸)", "price": 25, "bundle": 10 },
      "bait_black":  { "kind": "bait", "name": "검은 미끼",   "desc": "희귀·전설 ×2 · 큰 크기 ↑ · 빨리 상함",    "price": 40, "bundle": 10 },
      "rod_2":  { "kind": "rod",  "level": 2, "name": "낚싯대 Lv2", "desc": "감기 속도 ×1.15", "price": 300 },
      "rod_3":  { "kind": "rod",  "level": 3, "name": "낚싯대 Lv3", "desc": "감기 속도 ×1.3",  "price": 1000 },
      "rod_4":  { "kind": "rod",  "level": 4, "name": "낚싯대 Lv4", "desc": "감기 속도 ×1.45", "price": 3500 },
      "rod_5":  { "kind": "rod",  "level": 5, "name": "낚싯대 Lv5", "desc": "감기 속도 ×1.6",  "price": 10000 },
      "line_2": { "kind": "line", "level": 2, "name": "낚싯줄 Lv2", "desc": "텐션 최대 120",   "price": 250 },
      "line_3": { "kind": "line", "level": 3, "name": "낚싯줄 Lv3", "desc": "텐션 최대 140",   "price": 900 },
      "line_4": { "kind": "line", "level": 4, "name": "낚싯줄 Lv4", "desc": "텐션 최대 165",   "price": 3000 },
      "line_5": { "kind": "line", "level": 5, "name": "낚싯줄 Lv5", "desc": "텐션 최대 190",   "price": 8500 },
      "hull_2": { "kind": "hull", "level": 2, "name": "선체 Lv2", "desc": "청빛 바다 · 내구도 150",            "price": 800 },
      "hull_3": { "kind": "hull", "level": 3, "name": "선체 Lv3", "desc": "남빛 바다 · 내구도 220",            "price": 2500 },
      "hull_4": { "kind": "hull", "level": 4, "name": "선체 Lv4", "desc": "먹빛 바다(등불 필요) · 내구도 300", "price": 6000 },
      "tank_2": { "kind": "tank", "level": 2, "name": "연료통 Lv2", "desc": "연료 최대 200 · 남빛 진입 조건", "price": 1200 },
      "tank_3": { "kind": "tank", "level": 3, "name": "연료통 Lv3", "desc": "연료 최대 350",                  "price": 4000 },
      "ice_1":  { "kind": "ice",  "level": 1, "name": "얼음 창고 Lv1", "desc": "신선도 감소 0.7%/분",  "price": 400 },
      "ice_2":  { "kind": "ice",  "level": 2, "name": "얼음 창고 Lv2", "desc": "신선도 감소 0.5%/분",  "price": 1500 },
      "ice_3":  { "kind": "ice",  "level": 3, "name": "얼음 창고 Lv3", "desc": "신선도 감소 0.35%/분", "price": 5000 },
      "hold_2": { "kind": "hold", "level": 2, "name": "화물칸 Lv2", "desc": "창고 30칸", "price": 500 },
      "hold_3": { "kind": "hold", "level": 3, "name": "화물칸 Lv3", "desc": "창고 45칸", "price": 2000 },
      "hold_4": { "kind": "hold", "level": 4, "name": "화물칸 Lv4", "desc": "창고 60칸", "price": 6000 },
      // 수리 키트 가격은 선체 레벨별 (economy.repairKitPrice). 여기 price는 쓰지 않는다
      "repair_kit": { "kind": "consumable", "name": "수리 키트", "desc": "바다 위에서 내구도 25% 회복 · 최대 3개", "price": 0, "max": 3 },
      "salt":       { "kind": "consumable", "name": "소금",      "desc": "물고기 1마리 신선도 고정 · 판매가 ×0.9",  "price": 10 },
      "ice_chunk":  { "kind": "consumable", "name": "얼음 덩이", "desc": "창고 전체 신선도 +10%p",                 "price": 15 }
    }
  },

  // ─────────────────────────────────────────────────────────────────────────────────────
  //  6. 점수 (진실 이후, design §4-4 · §4-5) — 판매할 때 정산
  // ─────────────────────────────────────────────────────────────────────────────────────
  "scoring": {
    "basePoints": { "common": 10, "uncommon": 30, "rare": 100, "legendary": 300 },
    "trashPoints": 2,
    "sizeMult": { "D": 0.5, "C": 0.8, "B": 1, "A": 1.4, "S": 2 },
    "seaMult": { "jade": 1, "azure": 1.5, "indigo": 2, "ink": 3 },
    "weatherMult": { "clear": 1, "storm": 1.3 },
    "bossScoreMult": { "C": 10, "B": 15, "A": 25, "S": 50 },
    // 오염 징조: 누적 점수가 임계치를 넘으면 확률로 징조가 뜨고, 징조가 뜨면 N회 안에 오염체가 걸린다
    "omen": { "firstThreshold": 1000, "thresholdGrowth": 1.15, "baseChance": 0.35, "pityStep": 0.15, "guaranteedWithinCasts": 3 }
  }
}
